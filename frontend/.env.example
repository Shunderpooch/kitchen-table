# Copy to frontend/.env and fill in. The Python backend and the scheduled
# tasks read the household settings from this file too.

# SQLite database shared by the app and the Python backend.
DATABASE_URL="file:../data/expenses.db"
# The backend's Python (a virtualenv with backend/requirements installed).
PYTHON_BIN="C:/path/to/venv/Scripts/python.exe"

# --- Household -------------------------------------------------------------
# One or two people; spending is split between them. The first is "member A".
HOUSEHOLD_MEMBERS="Alex,Sam"
# The owner's first,last name, so scanned documents that mention it are not
# filed as someone else's.
SELF_NAME="alex,smith"
# Statement sources created at `init`: each member's cards and bank accounts,
# named "<member> <card>" (e.g. "Alex Amex").
STATEMENT_CARDS="Amex,Discover,Visa"
BANK_ACCOUNTS="Checking"
# People who share some expenses with you (optional).
FRIENDS=""
# Filename of an exported household spreadsheet treated as canonical history (optional).
HOUSEHOLD_SHEET="Household Expenses.csv"

# --- Scans -----------------------------------------------------------------
# OneDrive (or any synced) folder the documents are filed into; defaults to %OneDrive%.
# ONEDRIVE_ROOT="C:/Users/you/OneDrive"

# --- Home network ----------------------------------------------------------
# Required to open the app from other devices (scripts/windows/start_server.ps1).
APP_PASSWORD=""
